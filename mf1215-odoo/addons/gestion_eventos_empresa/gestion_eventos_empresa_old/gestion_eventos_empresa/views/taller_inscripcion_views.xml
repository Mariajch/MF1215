<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="taller_inscripcion_view_list" model="ir.ui.view">
        <field name="name">taller.inscripcion.list</field>
        <field name="model">taller.inscripcion</field>
        <field name="arch" type="xml">
            <list string="Inscripciones">
                <field name="evento_id"/>
                <field name="partner_id"/>
                <field name="email" optional="hide"/>
                <field name="fecha_inscripcion"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'borrador'"
                       decoration-success="state == 'confirmada'"
                       decoration-muted="state == 'cancelada'"/>
            </list>
        </field>
    </record>

    <record id="taller_inscripcion_view_form" model="ir.ui.view">
        <field name="name">taller.inscripcion.form</field>
        <field name="model">taller.inscripcion</field>
        <field name="arch" type="xml">
            <form string="Inscripción">
                <header>
                    <button name="action_confirmar" type="object" string="Confirmar"
                            class="btn-primary" invisible="state != 'borrador'"/>
                    <button name="action_cancelar" type="object" string="Cancelar"
                            invisible="state == 'cancelada'"/>
                    <button name="action_borrador" type="object" string="Volver a borrador"
                            invisible="state != 'cancelada'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="borrador,confirmada,cancelada"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="evento_id"/>
                            <field name="fecha_evento"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="email"/>
                            <field name="fecha_inscripcion"/>
                        </group>
                    </group>
                    <field name="notas" placeholder="Notas..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="taller_inscripcion_view_search" model="ir.ui.view">
        <field name="name">taller.inscripcion.search</field>
        <field name="model">taller.inscripcion</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="evento_id"/>
                <filter name="filter_borrador" string="Borrador"
                        domain="[('state', '=', 'borrador')]"/>
                <filter name="filter_confirmada" string="Confirmadas"
                        domain="[('state', '=', 'confirmada')]"/>
                <filter name="filter_cancelada" string="Canceladas"
                        domain="[('state', '=', 'cancelada')]"/>
                <group>
                    <filter name="group_evento" string="Evento"
                            context="{'group_by': 'evento_id'}"/>
                    <filter name="group_state" string="Estado"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="taller_inscripcion_action" model="ir.actions.act_window">
        <field name="name">Inscripciones</field>
        <field name="res_model">taller.inscripcion</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_borrador': 1}</field>
    </record>
</odoo>
