
<odoo>
    <!-- Vista de lista -->
    <record id="seguimiento_cliente_view_list" model="ir.ui.view">
        <field name="name">seguimiento.cliente.list</field>
        <field name="model">seguimiento.cliente</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="cliente_id"/>
                <field name="fecha"/>
                <field name="estado"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario -->
    <record id="seguimiento_cliente_view_form" model="ir.ui.view">
        <field name="name">seguimiento.cliente.form</field>
        <field name="model">seguimiento.cliente</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_marcar_realizado"
                            type="object"
                            string="Marcar como realizado"
                            class="btn-primary"
                            invisible="estado == 'realizado'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="cliente_id"/>
                        </group>
                        <group>
                            <field name="fecha"/>
                            <field name="estado"/>
                        </group>
                    </group>
                    <field name="notas"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de ventana -->
    <record id="seguimiento_cliente_action" model="ir.actions.act_window">
        <field name="name">Seguimiento de clientes</field>
        <field name="res_model">seguimiento.cliente</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menús -->
    <menuitem id="seguimiento_cliente_menu_root"
              name="Seguimiento de clientes"
              sequence="10"/>

    <menuitem id="seguimiento_cliente_menu"
              name="Seguimientos"
              parent="seguimiento_cliente_menu_root"
              action="seguimiento_cliente_action"
              sequence="10"/>
</odoo>
